# Copy to .env for the local server; never commit .env.
# Leave SECRET_KEY empty to retain the random instance/.secret already generated.
SECRET_KEY=
# Customer deployment: accounts are created by the local operator.
ALLOW_REGISTRATION=0
# Production file/document handling requires the isolated Docker worker.
# native is an explicit demonstration-only mode, never an automatic fallback.
PE_WORKER_MODE=docker
PE_WORKER_IMAGE=sentinel-pe-worker:local
# Optional: use Docker Engine inside this dedicated WSL 2 distribution.
# Leave empty for a directly installed Docker CLI.
SENTINEL_WSL_DISTRO=
# Optional external checks; consented hash/IP indicators, URLs or complete files are sent.
# The optional reputation step on a local PE assessment sends only its SHA-256.
VIRUSTOTAL_API_KEY=
# Local HTTP is loopback-only. Never expose this server through a tunnel/proxy.
COOKIE_SECURE=0
# Optional MySQL configuration (SQLite is the tested local default).
# Use letters/numbers for MYSQL_PASSWORD because it is inserted into DATABASE_URL.
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Local AI inference; never use a cloud model or a remote endpoint.
LOCAL_AI_URL=http://127.0.0.1:11434
LOCAL_AI_MODEL=qwen3:4b
LOCAL_AI_RUNTIME_DIR=D:/SentinelRuntime/ai
LOCAL_AI_TIMEOUT=600
OPENBIN_WORKER_IMAGE=sentinel-openbin-worker:local
